# Enforce LF in the repo so WSL/Windows checkouts don't churn line endings.
* text=auto eol=lf

*.go    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.ico   binary
